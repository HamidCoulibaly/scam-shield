	<string>Scam Shield reads phone numbers from your contacts so they are never blocked. They never leave this iPhone.</string>
	<key>ScamListURL</key>
	<string>https://raw.githubusercontent.com/HamidCoulibaly/scam-shield/main/collector/dist/scamlist.json</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
